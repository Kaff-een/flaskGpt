# Fournisseur de génération : ollama | openai | demo
LLM_PROVIDER=ollama

# --- Ollama (local) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# --- API compatible OpenAI (facultatif) ---
# LLM_PROVIDER=openai
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_API_KEY=sk-...

# Autorise une réponse locale construite à partir des sources si la connexion échoue.
ALLOW_DEMO_FALLBACK=true

# Délai maximal de génération en secondes.
LLM_TIMEOUT=300

# Nombre maximal de tokens générés par réponse.
LLM_MAX_TOKENS=1024
